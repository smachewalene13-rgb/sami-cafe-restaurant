{
  "name": "sami-cafe-restaurant",
  "version": "1.0.0",
  "private": true,
  "description": "Sami Cafe and Restaurant Full-Stack Monorepo",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "build": "npm --prefix server install && echo 'Server build complete'",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run preview",
    "seed": "npm --prefix server run seed"
  }
}
